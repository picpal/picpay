# infra/.env.infra.example
# Copy to infra/.env.infra and fill in values
# Usage: source infra/.env.infra && ./infra/01-vpc-setup.sh

# Required for EC2 setup
KEY_NAME=picpay-key          # EC2 key pair name (without .pem extension)

# Required for RDS + deployment
DB_PASSWORD=your-strong-password-here

# Required for GitHub Actions CD
# Set these as GitHub Actions secrets after running the scripts:
# EC2_HOST          = EC2-A Public IP (auto-updated by start-ec2.sh)
# EC2_B_PRIVATE_IP  = EC2-B Private IP (from infra-ids.env after 02-ec2-setup.sh)
# RDS_HOST          = RDS endpoint (from infra-ids.env after 03-rds-setup.sh)
# DB_PASSWORD       = same as above
# JWT_SECRET        = base64-encoded JWT secret (min 32 bytes)
# VAULT_AES_KEY     = base64-encoded AES-256 key (32 bytes)
# EC2_SSH_KEY       = contents of ~/.ssh/${KEY_NAME}.pem

# Optional overrides
# REGION=ap-northeast-2
# AMI_ID=ami-0c9c942bd7bf113a2   # Ubuntu 24.04 LTS ap-northeast-2 (2024)
